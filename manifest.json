{
  "manifest_version": 3,
  "name": "JP Subtitle Hover",
  "version": "1.0.0",
  "description": "Hover Japanese subtitle text (asbplayer, Netflix, YouTube) for reading + English gloss with sentence translation.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "JP Subtitle Hover settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
